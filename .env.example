# Copy this file to .env for local Docker Compose configuration.
# Do not commit real secrets.

# Required for the API container. The current app fails fast without it.
OPENAI_API_KEY=

# Host ports. Container-internal ports remain 8000 for API and 5432 for PostgreSQL.
DEEP_READER_API_PORT=8000
DEEP_READER_POSTGRES_PORT=5433

# Host data directory mounted into /app/Deep_Reflective_Reader/data in the API container.
DEEP_READER_DATA_DIR=./Deep_Reflective_Reader/data

# Structured document persistence backend.
# Docker Compose defaults to postgres; use file for local compatibility/debug.
DEEP_READER_STRUCTURED_STORAGE_BACKEND=postgres

# PDF OCR. Disabled by default; enable for scanned-image PDFs after rebuilding the API image.
DEEP_READER_PDF_OCR_ENABLED=1
DEEP_READER_PDF_OCR_LANGUAGE=eng+chi_sim+chi_tra
DEEP_READER_PDF_OCR_CACHE_ENABLED=1
DEEP_READER_PDF_RENDERER_CMD=pdftoppm
DEEP_READER_PDF_RENDER_DPI=200

# Local PostgreSQL development credentials.
POSTGRES_DB=deep_reader
POSTGRES_USER=deep_reader
POSTGRES_PASSWORD=deep_reader_dev
